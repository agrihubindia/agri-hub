<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agri Hub India</title>
    <!-- FontAwesome for 3D/Animated Social Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Global Styles & Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            position: relative;
            min-height: 100vh;
            color: #fff;
            overflow-x: hidden;
        }

        /* Background Video with Blur & Transparency */
        .bg-video-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .bg-video-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(8px);
            transform: scale(1.1);
        }

        .bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55); /* Transparent dark overlay for readability */
            z-index: 1;
        }

        /* Main Wrapper */
        .main-wrapper {
            position: relative;
            z-index: 2;
            max-width: 1300px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header & Profile Section */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 15px 30px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #4CAF50;
        }

        .profile-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .profile-pic-preview {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #4CAF50;
            background: #ddd;
        }

        .profile-upload-label {
            background: #4CAF50;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.3s;
        }

        .profile-upload-label:hover {
            background: #45a049;
        }

        #profile-upload-input {
            display: none;
        }

        /* Banners Section */
        .banner-section {
            background: rgba(255, 255, 255, 0.15);
            padding: 30px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 20px;
            backdrop-filter: blur(5px);
        }

        /* Yellow Notice/Highlight Box */
        .yellow-box {
            background: #ffeb3b;
            color: #333;
            padding: 15px 20px;
            border-radius: 8px;
            font-weight: bold;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        /* Layout Grid for Desktop: Content Left, Quiz Right */
        .content-layout {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 20px;
            align-items: start;
            margin-bottom: 20px;
        }

        .left-content {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Courses Section */
        .courses-section {
            background: rgba(0, 0, 0, 0.4);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .course-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Quiz Section (Right Side on Desktop) */
        .quiz-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            position: sticky;
            top: 20px;
        }

        /* 3D Animated Social Media Icons */
        .social-container {
            display: flex;
            gap: 20px;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            margin-top: 20px;
        }

        .social-icon {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 50px;
            height: 50px;
            background: #ffffff;
            color: #333;
            border-radius: 50%;
            font-size: 22px;
            text-decoration: none;
            box-shadow: 0 10px 15px rgba(0,0,0,0.3), inset 0 -4px 6px rgba(0,0,0,0.2), inset 0 4px 6px rgba(255,255,255,0.8);
            transition: transform 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
            animation: floatIcon 3s ease-in-out infinite;
        }

        .social-icon:nth-child(2) { animation-delay: 0.5s; }
        .social-icon:nth-child(3) { animation-delay: 1s; }
        .social-icon:nth-child(4) { animation-delay: 1.5s; }

        @keyframes floatIcon {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-6px) rotate(3deg); }
        }

        .social-icon:hover {
            transform: translateY(-10px) scale(1.1);
            box-shadow: 0 15px 25px rgba(0,0,0,0.4);
            color: #4CAF50;
        }

        /* Responsive Design for Mobile */
        @media (max-width: 900px) {
            .content-layout {
                grid-template-columns: 1fr;
            }
            .quiz-section {
                position: static;
            }
        }
    </style>
</head>
<body>

    <!-- Background Video Container -->
    <div class="bg-video-container">
        <div class="bg-overlay"></div>
        <!-- Aap yahan apni agriculture background video ka link laga sakte hain -->
        <video autoplay muted loop playsinline>
            <source src="https://assets.mixkit.co/videos/preview/mixkit-green-rice-field-in-the-wind-27950-large.mp4" type="video/mp4">
            Aapka browser video tag ko support nahi karta.
        </video>
    </div>

    <div class="main-wrapper">
        <!-- Header & Profile Section -->
        <header>
            <div class="logo">🌿 Agri Hub India</div>
            <div class="profile-container">
                <img id="user-profile-img" class="profile-pic-preview" src="https://via.placeholder.com/50" alt="Profile">
                <label class="profile-upload-label" for="profile-upload-input">
                    <i class="fa-solid fa-camera"></i> Change Photo
                </label>
                <input type="file" id="profile-upload-input" accept="image/*">
            </div>
        </header>

        <!-- Banners Section -->
        <section class="banner-section">
            <h1>Welcome to Agri Hub India</h1>
            <p>Aapka apna kheti-badi aur agriculture portal</p>
        </section>

        <!-- Yellow Box (Courses ke upar aur Banners ke niche) -->
        <div class="yellow-box">
            📢 <strong>Notice/Update:</strong> Naye agriculture courses live ho chuke hain! Jaldi enroll karein.
        </div>

        <!-- Content Layout: Left Courses, Right Quiz -->
        <div class="content-layout">
            <div class="left-content">
                <!-- Courses Section -->
                <section class="courses-section">
                    <h2>Available Courses</h2>
                    <div class="courses-grid">
                        <div class="course-card">
                            <h3>Organic Farming</h3>
                            <p>Sikhein organic kheti ke tarike.</p>
                        </div>
                        <div class="course-card">
                            <h3>Modern Irrigation</h3>
                            <p>Drip aur sprinkler irrigation guide.</p>
                        </div>
                        <div class="course-card">
                            <h3>Crop Protection</h3>
                            <p>Faslon ko keedo se bachane ke upay.</p>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Quiz Section (Desktop par right side mein) -->
            <aside class="quiz-section">
                <h3>🧠 Daily Agriculture Quiz</h3>
                <p style="margin: 10px 0; font-size: 14px;">Kheti se jude sawalon ke jawab dein aur apna gyan badhayein!</p>
                <button style="background: #4CAF50; color: white; border: none; padding: 10px 15px; border-radius: 6px; cursor: pointer; width: 100%; font-weight: bold;">Start Quiz</button>
            </aside>
        </div>

        <!-- 3D Animated Social Media Icons -->
        <div class="social-container">
            <a href="#" class="social-icon" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" class="social-icon" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" class="social-icon" title="YouTube"><i class="fa-brands fa-youtube"></i></a>
            <a href="#" class="social-icon" title="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
    </div>

    <!-- JavaScript to Handle Profile Persistence (LocalStorage) -->
    <script>
        const profileInput = document.getElementById('profile-upload-input');
        const profileImg = document.getElementById('user-profile-img');

        // Check if profile picture already exists in localStorage
        window.addEventListener('DOMContentLoaded', () => {
            const savedImage = localStorage.getItem('agriHubProfilePic');
            if (savedImage) {
                profileImg.src = savedImage;
            }
        });

        // Save new profile picture to localStorage so it doesn't disappear on login/refresh
        profileInput.addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64Image = e.target.result;
                    profileImg.src = base64Image;
                    localStorage.setItem('agriHubProfilePic', base64Image);
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>